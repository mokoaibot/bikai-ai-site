# ==================================================================
# .gitignore — monorepo Context-Driven мультиагентной системы
# ==================================================================

# --- Секреты: НИКОГДА не отправлять в публичный репозиторий ---
.env
.env.*
!.env.example
*.pem
*.key

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/

# --- Streamlit ---
.streamlit/secrets.toml

# --- Кэши / временные файлы окружения ---
.cache/
.local/
.nox/
.tox/
.turbo/
*.log.tmp

# --- ОС-специфичные мусорные файлы ---
.DS_Store
Thumbs.db

# --- Разовый мусор от инструментов генерации/поиска картинок ---
/Unselected files/
/image-search/

# --- Локальные файлы пользователя (если не нужно хранить в репо) ---
# Раскомментируйте строку ниже, если не хотите, чтобы содержимое
# local_dropzone/ (например, большие изображения) попадало в Git:
# local_dropzone/*
# !local_dropzone/.gitkeep
