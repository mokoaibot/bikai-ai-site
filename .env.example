# Скопируйте этот файл в .env и заполните реальными значениями.
# .env в .gitignore и никогда не попадает в репозиторий.

GITHUB_REPO_URL=https://github.com/OWNER/REPO.git
GITHUB_BRANCH=main
GITHUB_TOKEN=ваш_personal_access_token
GIT_USER_NAME=Arena Orchestrator
GIT_USER_EMAIL=orchestrator@arena.local
